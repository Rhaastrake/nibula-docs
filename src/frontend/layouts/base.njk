{# This is the base of every page that you will create #}

<!DOCTYPE html>
<html lang="{{ lang }}" data-theme="{{ site.theme or 'light' }}" data-bs-theme="{{ site.theme or 'light' }}">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="color-scheme" content="{{ site.theme or 'light' }}">

      {#╔══════════════════╗
        ║    PAGE DATA     ║
        ╚══════════════════╝#}

        {% set pageKey = title %}
        {% set pageData = pages[pageKey] %}
        {% set seo = pageData.seo[lang] %}
        {% set canonicalUrl = (site.url + canonical) if canonical else (pageData.canonical or (site.url + page.url)) %}
        {% set isIndexable = not (pageData.noindex or noindex or canonical) %}

      {#╔══════════════════╗
        ║       SEO        ║
        ╚══════════════════╝#}

        <link rel="canonical" href="{{ canonicalUrl }}"/>

        {% if isIndexable %}
        {% for alternate in site.languages %}
        <link rel="alternate" hreflang="{{ alternate.code }}" href="{{ site.url }}{{ alternate.prefix }}{{ pagePath }}">
        {% endfor %}
        <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ pagePath }}">
        {% endif %}

        <title>{{ seo.title or title or ui.site.title }}</title>
        <meta name="description" content="{{ seo.description or ui.site.description }}">
        <meta name="keywords" content="{{ seo.keywords or site.keywords }}">
        <meta name="author" content="{{ site.author.fullName }}">
        <meta name="theme-color" content="{{ site.themeColor }}">

        {% if pageData.noindex or noindex %}
        <meta name="robots" content="noindex, follow">
        {% endif %}

        {# Open Graph #}
        <meta property="og:title" content="{{ seo.title or title or ui.site.title }}">
        <meta property="og:description" content="{{ seo.description or ui.site.description }}">
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ canonicalUrl }}">
        <meta property="og:image" content="{{ site.url }}{{ site.socialImage }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content="{{ site.siteName }} logo">
        <meta property="og:site_name" content="{{ site.siteName }}">
        <meta property="og:locale" content="{{ language.locale }}">
        {% for alternate in site.languages %}
        {% if alternate.code != lang %}
        <meta property="og:locale:alternate" content="{{ alternate.locale }}">
        {% endif %}
        {% endfor %}

        {# Twitter Card #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ seo.title or title or ui.site.title }}">
        <meta name="twitter:description" content="{{ seo.description or ui.site.description }}">
        <meta name="twitter:image" content="{{ site.url }}{{ site.socialImage }}">
        <meta name="twitter:image:alt" content="{{ site.siteName }} logo">

      {#╔══════════════════════════════════════════╗
        ║   JSON-LD — Structured data for SEO/AI   ║
        ╚══════════════════════════════════════════╝#}

        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": {{ (seo.title or title or ui.site.title) | dump | safe }},
            "description": {{ (seo.description or ui.site.description) | dump | safe }},
            "url": {{ canonicalUrl | dump | safe }},
            "author": {
                "@type": "Person",
                "name": {{ site.author.fullName | dump | safe }},
                "url": {{ site.author.website | dump | safe }}
            },
            "publisher": {
                "@type": "Organization",
                "name": {{ site.siteName | dump | safe }},
                "logo": {
                    "@type": "ImageObject",
                    "url": {{ (site.url + site.logo) | dump | safe }}
                }
            }
        }
        </script>

        {% if title == "homepage" %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": {{ site.siteName | dump | safe }},
            "description": {{ ui.site.description | dump | safe }},
            "url": {{ site.url | dump | safe }},
            "applicationCategory": "DeveloperApplication",
            "operatingSystem": "Windows, macOS, Linux",
            "license": {{ site.license | dump | safe }},
            "downloadUrl": {{ site.npm | dump | safe }},
            "sameAs": [{{ site.repository | dump | safe }}, {{ site.npm | dump | safe }}],
            "author": {
                "@type": "Person",
                "name": {{ site.author.fullName | dump | safe }},
                "url": {{ site.author.website | dump | safe }}
            },
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "EUR"
            }
        }
        </script>
        {% elif title == "docs" %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "TechArticle",
            "headline": {{ (seo.title or ui.site.title) | dump | safe }},
            "description": {{ (seo.description or ui.site.description) | dump | safe }},
            "url": {{ canonicalUrl | dump | safe }},
            "inLanguage": {{ lang | dump | safe }},
            "version": {{ version | dump | safe }},
            "dateModified": {{ page.date.toISOString() | dump | safe }},
            "author": {
                "@type": "Person",
                "name": {{ site.author.fullName | dump | safe }},
                "url": {{ site.author.website | dump | safe }}
            },
            "about": {
                "@type": "SoftwareApplication",
                "name": {{ site.siteName | dump | safe }},
                "url": {{ site.url | dump | safe }}
            }
        }
        </script>
        {% endif %}

      {#╔══════════════════╗
        ║     FAVICON      ║
        ╚══════════════════╝#}

        <link rel="icon" type="image/svg+xml" href="{{ '/assets/brand/favicon.svg' | url }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/brand/favicon-32.png' | url }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/brand/apple-touch-icon.png' | url }}">

      {#╔══════════════════╗
        ║       CSS        ║
        ╚══════════════════╝#}

        <link rel="preload" href="{{ '/assets/fonts/jetbrains-mono-latin.woff2' | url }}" as="font" type="font/woff2" crossorigin>

        {# Page CSS #}
        <link rel="stylesheet" href="{{ '/css/prism.css' | url }}">
        
        <link rel="stylesheet" href="{{ ('/css/pages/' + title + '.css') | url }}"/>

        {# Per-page CDN CSS #}
        {% if pageData and pageData.cdn and pageData.cdn.css %}
            {% for link in pageData.cdn.css %}
                <link rel="stylesheet" href="{{ link }}">
            {% endfor %}
        {% endif %}

    </head>

    <body>

        {% include "global/header.njk" ignore missing %}

        <main>
            {{ content | safe }}
        </main>

        {% include "global/footer.njk" ignore missing %}

      {#╔══════════════════╗
        ║     SCRIPTS      ║
        ╚══════════════════╝#}

        {# Framework — uncomment the one you are using #}
        {# Bootstrap JS #}
        {# <script src="{{ '/js/bootstrap.bundle.min.js' | url }}" defer></script> #}

        {# Foundation JS #}
        {# <script src="{{ '/js/foundation.min.js' | url }}" defer></script> #}

        {# UIkit JS #}
        {# <script src="{{ '/js/uikit.min.js' | url }}" defer></script> #}
        {# <script src="{{ '/js/uikit-icons.min.js' | url }}" defer></script> #}

        {# Bulma — no JS needed #}

        {# Per-page CDN JS #}
        {% if pageData and pageData.cdn and pageData.cdn.js %}
            {% for script in pageData.cdn.js %}
                <script src="{{ script }}" defer></script>
            {% endfor %}
        {% endif %}

        <script id="i18n-strings" type="application/json">{{ ui.js | dump | safe }}</script>

        {# Page JS #}
        <script src="{{ ('/js/pages/' + title + '.js') | url }}"></script>

    </body>

</html>