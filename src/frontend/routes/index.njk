{% set features = [
    { title: "Centralized SEO", text: "Set your SEO once per page in a data file. Every tag, the sitemap and llms.txt rebuild themselves at every build" },
    { title: "Deploy ready", text: "The build folder is ready to upload as it is. The config your host expects is already inside, for Apache, IIS or nginx" },
    { title: "Backend included", text: "Need a contact form or an API? There’s a small backend ready to use, in Node or PHP" }
] %}

<section id="hero">
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="title">
                <h1>Nibula</h1>
                <p>A static site scaffolder, simplified for beginners</p>
                <article class="markdown-body">
                    {% renderFile "installation-command.md" | componentsPath, "njk,md" %}
                </article>
                <br>
                <div class="hero-buttons">
                    <a href="{{ '/docs/v3/#quick-start' | url }}" class="button generic-button">Quick start</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="feature-cards">
                {% for feature in features %}
                <div class="card">
                    <h3>{{ feature.title }}</h3>
                    <p>{{ feature.text }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>