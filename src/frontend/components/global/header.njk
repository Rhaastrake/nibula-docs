<header>
  <nav>
    <div class="brand">
      <a class="logo" href="{{ '/' | url }}">
        <img src="{{ site.logo }}" alt="{{ site.siteName }}"/>
      </a>

      <div class="brand-extras">
        {% if title == "docs" %}
          <select id="docsVersionSelect" class="form-select docs-version-select" aria-label="Documentation version">
            {% for v in versions %}
              <option value="{{ v.url | url }}" {% if v.id == version %}selected{% endif %}>{{ v.id }}</option>
            {% endfor %}
          </select>
        {% endif %}

        <div
          class="site-search"
          data-index="{{ '/search.json' | url }}"
          data-base="{{ '/' | url }}"
          data-version="{{ version or (docsVersions | last).id }}"
        >
          <input
            type="search"
            class="form-control site-search-input"
            placeholder="Search docs..."
            aria-label="Search"
            autocomplete="off"
          >
          <ul class="site-search-results" role="listbox" hidden></ul>
        </div>
      </div>
    </div>

    <button class="burger-menu" id="burger-btn" aria-label="Open menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <div class="links" id="nav-links">
      <a href="{{ '/docs/v3/' | url }}" class="button link-button">Documentation</a>
      <a href="{{ '/team/' | url }}" class="button link-button">Team</a>
      <a href="{{ '/faq/' | url }}" class="button link-button">FAQ</a>

      <div class="nav-slot nav-search-slot" id="nav-search-slot"></div>
      {% if title == "docs" %}
        <div class="nav-slot nav-index-slot" id="nav-index-slot"></div>
      {% endif %}

      <a href="https://github.com/rhaastrake/nibula" target="_blank" rel="noopener noreferrer" class="button link-button nav-social" aria-label="GitHub repository"><i class="bi bi-github" style="font-size: 1.5rem"></i></a>
    </div>
  </nav>
</header>