<footer>
  <div class="container">
    <div class="footer-columns row">
      <div class="col-12 col-md-4">
        <h3>{{ ui.site.title }}</h3>
        <p>{{ ui.site.description }}</p>
      </div>
      <div class="col-6 col-md-auto">
        <h3>{{ ui.footer.sitemap }}</h3>
        <ul>
          <li><a class="button link-button" href="{{ (langPrefix + '/') | url }}">{{ ui.nav.home }}</a></li>
          <li><a class="button link-button" href="{{ (langPrefix + '/docs/') | url }}">{{ ui.nav.docs }}</a></li>
          <li><a class="button link-button" href="{{ (langPrefix + '/team/') | url }}">{{ ui.nav.team }}</a></li>
          <li><a class="button link-button" href="{{ (langPrefix + '/faq/') | url }}">{{ ui.nav.faq }}</a></li>
        </ul>
      </div>
      <div class="col-6 col-md-auto">
        <h3>{{ ui.footer.social }}</h3>
        <ul>
          <li>
            <a class="button link-button" href="https://github.com/rhaastrake/nibula"
               target="_blank" rel="noopener noreferrer">
              <i class="bi bi-github" aria-hidden="true"></i> GitHub
            </a>
          </li>
          <li>
            <a class="button link-button"
               target="_blank" rel="noopener noreferrer" href="https://www.npmjs.com/package/nibula">
              <i class="bi bi-box" aria-hidden="true"></i> Npmjs
            </a>
          </li>
        </ul>
      </div>
    </div>

    <hr />

    <div class="footer-copyright">
      <p>
        &copy; {{ site.legal.copyright.year }}
        {{ site.siteName }}
      </p>
      <p>{{ site.legal.copyright.text }}</p>
    </div>
  </div>
</footer>